<section>
    <div class="text-center mb-4">
        <h2 class="h3 fw-bold" style="color: var(--Midnight);">
            <i class="bi bi-door-closed-fill me-2"></i>Iniciar Sesión
        </h2>
        <p class="text-muted">¡Continúa tu aventura!</p>
    </div>

    <form action="/login" method="POST">
        <div class="mb-3">
            <label for="correo" class="form-label fw-bold">Email</label>
            <input type="email" name="email" class="form-control" id="correo"
                   placeholder="nombre@ejemplo.com" required>
        </div>

        <div class="mb-3">
            <label for="password" class="form-label fw-bold">Password</label>
            <input type="password" name="password" class="form-control" id="password"
                   placeholder="••••••••" required>
        </div>

        <div class="d-grid gap-2">
            <button type="submit" class="btn btn-primary-rpg">Entrar</button>

            <button type="button" class="btn btn-outline-danger d-flex align-items-center justify-content-center">
                <i class="bi bi-google me-2"></i> Entrar con Google
            </button>
        </div>

        <hr class="my-4">

        <div class="text-center">
            <p class="mb-0">¿No tienes cuenta?</p>
            <a href="/signin" class="fw-bold" style="color: var(--BarbiePink);">Regístrate aquí</a>
        </div>
    </form>
</section>